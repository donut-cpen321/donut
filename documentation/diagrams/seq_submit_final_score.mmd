%% Use Case 3: Submit final score (Requirements_and_Design.md 3.5, 4.6), as the code does it:
%% the reported score waits until every other player confirms it (POST /games/score/confirm).
sequenceDiagram
  actor U as User
  actor O as Other player
  participant FE as Front-end
  participant G as Games
  participant L as Live updates
  participant R as Ranking
  participant T as Tournaments
  participant US as Users
  participant DB as PostgreSQL
  participant FCM as Firebase Cloud Messaging

  U->>FE: open the game, tap "Report final score"
  U->>FE: enter each set's score, submit
  FE->>G: POST /games/score {gameId, rounds: [team1, team2][]}
  alt no sets, a negative or tied set, an impossible tennis set, or equal sets won
    G-->>FE: 400 INVALID_REQUEST {details}
    FE-->>U: show what to correct
  else valid body
    G->>DB: fetchGame(gameId), isUserInGame(userId, gameId)
    DB-->>G: Game, boolean
    alt not found / not in the game / completed or cancelled / not started
      G-->>FE: 404 GAME_NOT_FOUND / 403 NOT_IN_GAME / 409 GAME_CLOSED / 409 GAME_NOT_STARTED
      FE-->>U: show the game's current state
    else IN_PROGRESS
      G->>DB: recordScore(gameId, userId, rounds, confirming = false, now)
      Note over G,DB: one transaction under the game's row lock: saves the score proposal,<br/>marks the reporter as confirmed and clears the other players' confirmations
      DB-->>G: outcome "proposed"
      G->>L: gameChanged({gameId})
      L-->>FE: SSE gameUpdated {game} (proposed score, who has confirmed)
      G->>US: pushToUsers(otherIds, {"Confirm the score", type: "scoreReported", gameId})
      US->>DB: getFcmTokens(userIds)
      DB-->>US: string[]
      US->>FCM: sendEach(messages)
      FCM-->>US: BatchResponse
      US-->>G: number of devices reached
      G-->>FE: 200 {completed: false}
      FE-->>U: show the score waiting for the other players
    end
  end

  FCM-->>FE: push "Confirm the score" {gameId} (other players' devices)
  FE-->>O: notification "Confirm the score"
  loop each other player
    O->>FE: open the game, tap "Confirm"
    FE->>G: POST /games/score/confirm {gameId, rounds}
    G->>DB: recordScore(gameId, userId, rounds, confirming = true, now)
    alt score was changed since the player saw it / nothing reported
      DB-->>G: outcome "scoreChanged" / "noProposal"
      G-->>FE: 409 SCORE_CHANGED / 409 NO_SCORE_TO_CONFIRM
    else other players still have to confirm
      DB-->>G: outcome "confirmed"
      G->>L: gameChanged({gameId})
      G-->>FE: 200 {completed: false}
    else last confirmation (same transaction)
      Note over G,DB: completeGame(tx, gameId, rounds, now): game COMPLETED, rounds saved, proposal deleted
      G->>R: applyGameResult(tx, gameId, format, rounds)
      R->>DB: fetchGamePlayerRatingsForUpdate(tx, gameId)
      DB-->>R: players with ratings and rated games
      alt a team is not full
        R-->>G: throw IncompleteTeamsError (rollback)
        G-->>FE: 409 INCOMPLETE_TEAMS
      else full teams
        R->>R: calculateELOChange(players, game): RatingChange[]
        R->>DB: saveRatingChanges(tx, gameId, changes)
        R-->>G: RatingChange[]
        opt tournament game
          G->>T: advanceBracket(tx, gameId, rounds, now)
          T->>DB: record the winner, book the next match
        end
        alt Postgres aborts the transaction (deadlock)
          DB-->>G: P2034 (nothing saved)
          G-->>FE: 409 SCORE_CONFLICT, the player can retry
        else committed
          DB-->>G: outcome "completed" {game, rounds, ratingChanges}
          G->>L: gameChanged({gameId})
          L-->>FE: SSE gameUpdated {game} to every player watching
          G-->>FE: 200 {completed: true, game, rounds, ratingChanges}
          FE-->>O: show the final score
        end
      end
    end
  end
  opt a player disagrees
    Note over O,G: POST /games/score with the corrected rounds replaces the proposal,<br/>and every other player has to confirm again
  end
  FE-->>U: show the final score, and the match summary<br/>(ratings before and after) in the match history
