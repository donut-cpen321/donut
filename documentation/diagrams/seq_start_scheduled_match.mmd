%% Use Case 2: Check in to a scheduled match (Requirements_and_Design.md 3.5, 4.6)
%% PLANNED: backend/src has no check-in route or job yet. POST /games/check-in is the interface
%% declared in 4.1 (Games 14); the steps marked (planned) have no code. Today a booked game is
%% started with POST /games/start (games.service.ts startGame).
sequenceDiagram
  actor U as User
  participant FE as Front-end
  participant G as Games
  participant L as Live updates
  participant US as Users
  participant DB as PostgreSQL
  participant FCM as Firebase Cloud Messaging

  Note over U,FCM: Planned design: POST /games/check-in and the check-in job are not implemented in backend/src yet
  loop every minute (check-in job, planned)
    G->>DB: find BOOKED or OPEN scheduled games whose start time has come (planned)
    DB-->>G: Game[]
    alt a scheduled game still has open spots
      G->>DB: mark the game CANCELLED (planned)
      G->>L: gameChanged({gameId})
      G->>US: pushToUsers(playerIds, {"Game cancelled", gameId})
      US->>FCM: sendEach(messages)
      FCM-->>US: BatchResponse
    else booked
      G->>US: pushToUsers(playerIds, {"Check in at the court", gameId})
      US->>DB: getFcmTokens(userIds)
      DB-->>US: string[]
      US->>FCM: sendEach(messages)
      FCM-->>US: BatchResponse
      FCM-->>FE: push "Check in" {gameId}
    end
  end

  U->>FE: open the game, tap "I'm here"
  FE->>G: POST /games/check-in {gameId} (planned)
  alt before the start time or after the 30-minute window
    G-->>FE: 409 {reason}
    FE-->>U: explain why the check-in was not recorded
  else within the window
    G->>DB: record the player's check-in (planned)
    DB-->>G: players with their check-ins
    alt other players haven't checked in yet
      G->>L: gameChanged({gameId})
      G-->>FE: 200 {game}
      L-->>FE: SSE gameUpdated {game} (who has checked in)
      FE-->>U: show who has confirmed
    else last player checks in
      G->>DB: mark the game IN_PROGRESS (planned, like startBookedGame)
      G->>L: gameChanged({gameId})
      G->>US: pushToUsers(playerIds, {"Game started", gameId})
      US->>FCM: sendEach(messages)
      FCM-->>US: BatchResponse
      G-->>FE: 200 {game}
      FE-->>U: show the game in progress, with "Report final score"
    end
  end

  loop every minute (check-in job, planned)
    G->>DB: find booked games 30 min past their start that not everyone checked in to (planned)
    DB-->>G: Game[]
    G->>DB: mark each game CANCELLED (planned)
    G->>L: gameChanged({gameId})
    G->>US: pushToUsers(playerIds, {"Game cancelled", gameId})
    US->>FCM: sendEach(messages)
    FCM-->>US: BatchResponse
  end
