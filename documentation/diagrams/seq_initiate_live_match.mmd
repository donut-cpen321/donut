%% Use Case 1: Initiate live match (Requirements_and_Design.md 3.5, 4.6)
sequenceDiagram
  actor U as User
  participant FE as Front-end
  participant GM as Google Maps Platform
  participant MM as Matchmaking
  participant L as Live updates
  participant US as Users
  participant DB as PostgreSQL
  participant FCM as Firebase Cloud Messaging

  U->>FE: open the Matchmaking tab, pick a format
  U->>FE: pick where to play (current location or an address)
  opt an address
    FE->>GM: PlacesClient.fetchPlace(placeId)
    GM-->>FE: Place {latLng}
  end
  U->>FE: tap "Find a match"
  FE->>MM: POST /matchmaking {format, latitude, longitude}
  MM->>DB: hasActiveMatch(userId, now)
  DB-->>MM: boolean
  alt matched game waiting for answers or booked
    MM-->>FE: 403 ALREADY_HAS_MATCH
    FE-->>U: show the error
  else no active match
    MM->>DB: createRequest(userId, {format, latitude, longitude})
    alt already in the queue (unique violation)
      DB-->>MM: P2002
      MM-->>FE: 409 ALREADY_IN_QUEUE
      FE-->>U: show the existing search
    else added
      DB-->>MM: QueueEntry
      MM->>L: queueChanged()
      MM-->>FE: 201 {request}
      FE-->>U: show "Searching"
      FE->>MM: GET /matchmaking/events (SSE)
      MM-->>FE: nearby {center, players}
      FE->>L: GET /games/feed/events (SSE, "mine" list)
    end
  end

  loop every 10 s (matchmaking job, node-cron)
    MM->>DB: getCandidates()
    DB-->>MM: Candidate[]
    MM->>MM: findMatches(candidates): Match[]
    opt no compatible players
      Note over MM: the user stays queued until the next run
    end
    loop each Match
      MM->>DB: getMatchedPlayers(userIds)
      DB-->>MM: MatchedPlayer[] (ratings, preferred courts)
      MM->>MM: chooseCourt(players, locations): courtId
      opt no preferred court within 10 km of everyone
        MM->>DB: getCourts()
        DB-->>MM: CourtLocation[]
        MM->>MM: nearestCourt(courts, locations): courtId
      end
      MM->>MM: assignTeams(match, players)
      MM->>DB: claimMatch(userIds, game: MATCHED, OPEN, startsAt = now + 1 h)
      Note over MM,DB: one transaction: removes the players from the queue, creates the game
      alt a player left the queue first
        DB-->>MM: null (match skipped)
      else claimed
        DB-->>MM: ClaimedGame {id, court}
        MM->>L: gameChanged({gameId})
        L-->>FE: SSE mine {games, tournaments} with the proposed game
        MM->>US: pushToUsers(userIds, {title: "Match found!", data: {gameId}})
        US->>DB: getFcmTokens(userIds)
        DB-->>US: string[]
        US->>FCM: sendEach(messages)
        FCM-->>US: BatchResponse
        opt dead tokens
          US->>DB: clearFcmTokens(tokens)
        end
        US-->>MM: number of devices reached
        FCM-->>FE: push "Match found!" {gameId}
      end
    end
    MM->>L: queueChanged()
    L-->>FE: SSE nearby (matched players drop off the map)
  end

  FE->>GM: GoogleMap(Marker at the game's court)
  FE-->>U: show the match (court, time, players) with Accept / Decline
