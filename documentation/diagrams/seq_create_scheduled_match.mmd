%% Use Case 4: Create a scheduled match (Requirements_and_Design.md 3.5, 4.6)
sequenceDiagram
  actor U as User
  participant FE as Front-end
  participant GM as Google Maps Platform
  participant US as Users
  participant G as Games
  participant L as Live updates
  participant DB as PostgreSQL
  participant OW as OpenWeather

  U->>FE: open the Games tab, tap "Schedule", pick "Game"
  U->>FE: pick the format, start date and time
  opt start time not in the future
    FE-->>U: ask for a start time in the future
  end
  U->>FE: open the court picker
  FE->>US: GET /courts
  US->>DB: fetchCourts()
  DB-->>US: Court[]
  alt courts can't be loaded
    US-->>FE: error / no response
    FE-->>U: show an error with a retry button
  else loaded
    US-->>FE: 200 {courts: {id, name, latitude, longitude}[]}
    FE->>GM: GoogleMap(Marker per court)
    FE-->>U: show the courts as a list (and on the map)
  end
  U->>FE: tap a court in the list, submit the form
  FE->>G: POST /games {format, startsAt, courtId, gameSource: "SCHEDULED"}
  alt invalid body or start time not in the future
    G-->>FE: 400 INVALID_REQUEST {details}
    FE-->>U: show the error
  else valid
    G->>DB: createGame({format, startsAt, courtId, gameSource, status: OPEN}, userId)
    Note over G,DB: the creator is added to team 1
    alt court doesn't exist (foreign key, P2003)
      DB-->>G: error
      G-->>FE: 404 COURT_NOT_FOUND
      FE-->>U: show the error
    else created
      DB-->>G: Game
      G->>L: gameChanged({gameId})
      G-->>FE: 201 {game}
      FE-->>U: show the new game
    end
  end
  opt server can't be reached
    FE-->>U: show an error, keep the form filled in
  end

  Note over FE,OW: after gameChanged, Live updates refreshes every Games tab that has GET /games/feed/events open
  L->>G: getFeed()
  G->>DB: fetchFeedGames(now)
  DB-->>G: GameDetails[] (OPEN scheduled games not started, soonest first)
  loop each game
    G->>OW: getForecast(latitude, longitude, startsAt): GET /data/2.5/forecast?lat&lon&units=metric&appid
    Note over G,OW: cached per court for 10 min, 2 s timeout, skipped more than 5 days ahead
    alt forecast fails or out of range
      OW-->>G: error / not called
      Note over G: forecast = null
    else
      OW-->>G: 3-hour forecast steps
      Note over G: the step nearest the start time
    end
  end
  G-->>L: FeedGame[]
  L-->>FE: SSE feed {games, tournaments}
  FE-->>U: the new game appears in the feed with its forecast
