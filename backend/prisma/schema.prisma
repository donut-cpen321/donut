// Donut database schema.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Sport {
  TENNIS
  PICKLEBALL
  BADMINTON
}

enum Format {
  SINGLES
  DOUBLES
}

enum FormatPreference {
  SINGLES
  DOUBLES
  EITHER
}

// OPEN: a SCHEDULED game with free spots on the feed, or a MATCHED game waiting for every player to accept
// BOOKED: all spots filled / all players accepted
// COMPLETED: score entered
// CANCELLED: acceptance deadline missed
enum GameStatus {
  OPEN
  BOOKED
  COMPLETED
  CANCELLED
}

// SCHEDULED: created by a player. 
// MATCHED: proposed by matchmaking.
enum GameSource {
  SCHEDULED
  MATCHED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  googleSub String   @unique // Google's stable account id
  username  String   @unique
  name      String // real name from Google
  email     String
  fcmToken  String? // for push notifications
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  ratings         UserRating[]
  preferredCourts Court[]
  availabilities  UserAvailability[]
  games           GameUser[]

  @@map("users")
}

// One rating per player per sport. A row is created on the player's first game in that sport.
model UserRating {
  userId      String @db.Uuid
  sport       Sport
  rating      Float  @default(1500) // starting value
  gamesPlayed Int    @default(0) // drives the K factor for the elo calculation

  // One-to-many relation between User and UserRating
  user User @relation(fields: [userId], references: [id])

  @@id([userId, sport])
  @@map("user_ratings")
}

model Court {
  id            Int     @id @default(autoincrement())
  googlePlaceId String? @unique // null for courts not on Google Maps
  name          String
  latitude      Float
  longitude     Float

  preferredBy User[]
  games       Game[]

  @@map("courts")
}

// Either a weekly pattern (weekday set) or a one-off date (date set), never both.
model UserAvailability {
  id        Int              @id @default(autoincrement())
  userId    String           @db.Uuid
  sport     Sport
  format    FormatPreference
  weekday   Int? // 0 = Sunday ... 6 = Saturday
  date      DateTime?        @db.Date
  startTime DateTime         @db.Time(0)
  endTime   DateTime         @db.Time(0)

  // One-to-many relation between User and UserAvailability
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_availabilities")
}

model Game {
  id         String     @id @default(uuid()) @db.Uuid
  sport      Sport
  format     Format
  status     GameStatus
  startsAt   DateTime   @db.Timestamptz(3)
  courtId    Int
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  gameSource GameSource

  // One-to-many relation between Court and Game
  court   Court       @relation(fields: [courtId], references: [id])

  players GameUser[]
  rounds  GameRound[]

  @@index([courtId])
  @@map("games")
}

// Same shape for singles (1 per team) and doubles (2 per team).
model GameUser {
  gameId     String    @db.Uuid
  userId     String    @db.Uuid
  team       Int
  acceptedAt DateTime? @db.Timestamptz(3) // MATCHED games only; null until the player accepts

  // One-to-many relation between Game and GameUser
  game Game @relation(fields: [gameId], references: [id])

  // One-to-many relation between User and GameUser
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@id([gameId, userId])
  @@map("game_users")
}

// A set in tennis, a game in pickleball/badminton
model GameRound {
  gameId     String @db.Uuid
  number     Int
  team1Score Int
  team2Score Int

  // One-to-many relation between Game and GameRound
  game Game @relation(fields: [gameId], references: [id])

  @@id([gameId, number])
  @@map("game_rounds")
}
