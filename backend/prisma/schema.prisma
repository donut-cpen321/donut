// Donut database schema.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Format {
  SINGLES
  DOUBLES
}

enum FormatPreference {
  SINGLES
  DOUBLES
  EITHER
}

// OPEN: a SCHEDULED game with free spots on the feed, or a MATCHED game waiting for every player to accept
// BOOKED: all spots filled / all players accepted
// COMPLETED: score entered
// CANCELLED: acceptance deadline missed
enum GameStatus {
  OPEN
  BOOKED
  COMPLETED
  CANCELLED
}

// SCHEDULED: created by a player. 
// MATCHED: proposed by matchmaking.
// TOURNAMENT: a match in a tournament bracket, created once both of its teams are known. Never on the feed.
enum GameSource {
  SCHEDULED
  MATCHED
  TOURNAMENT
}

// REGISTRATION: taking players, on the feed until it is full or starts
// IN_PROGRESS: full; the bracket is drawn and its games are being played
// COMPLETED: the final has been reported
// CANCELLED: cancelled by its creator during registration
enum TournamentStatus {
  REGISTRATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum EquipmentType {
  RACKET
  BALLS
  SHOES
  OTHER
}

model Friendship {
  requesterId String           @db.Uuid
  addresseeId String           @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  acceptedAt  DateTime?        @db.Timestamptz(3)

  requester User @relation("FriendshipsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@id([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  googleSub String   @unique // Google's stable account id
  username  String   @unique
  name      String // real name from Google
  email     String
  fcmToken  String? // for push notifications
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  rating          Float @default(1500) // starting value
  preferredCourts Court[]
  availabilities  UserAvailability[]
  games           GameUser[]
  matchmakingRequest MatchmakingRequest?
  refreshTokens   RefreshToken[]

  friendshipsSent     Friendship[] @relation("FriendshipsSent")
  friendshipsReceived Friendship[] @relation("FriendshipsReceived")
  equipment           Equipment[]

  tournamentsCreated Tournament[]       @relation("TournamentsCreated")
  tournamentEntries  TournamentPlayer[]

  @@index([rating(sort: Desc), username]) // leaderboard order
  @@map("users")
}

model Court {
  id            Int     @id @default(autoincrement())
  googlePlaceId String? @unique // null for courts not on Google Maps
  name          String
  latitude      Float
  longitude     Float

  preferredBy User[]
  games       Game[]
  tournaments Tournament[]

  @@map("courts")
}

// Either a weekly pattern (weekday set) or a one-off date (date set), never both.
model UserAvailability {
  id        Int              @id @default(autoincrement())
  userId    String           @db.Uuid
  format    FormatPreference
  weekday   Int? // 0 = Sunday ... 6 = Saturday
  date      DateTime?        @db.Date
  startTime DateTime         @db.Time(0)
  endTime   DateTime         @db.Time(0)

  // One-to-many relation between User and UserAvailability
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_availabilities")
}

// A player searching for a game right now.
model MatchmakingRequest {
  userId    String           @id @db.Uuid
  format    FormatPreference
  latitude  Float
  longitude Float
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  // One-to-one relation between User and MatchmakingRequest
  user User @relation(fields: [userId], references: [id])

  @@map("matchmaking_requests")
}

// A refresh token used for authentication after the access token has expired.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique // SHA-256 of the token sent to the frontend
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  // One-to-many relation between User and RefreshToken
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Game {
  id         String     @id @default(uuid()) @db.Uuid
  format     Format
  status     GameStatus
  startsAt   DateTime   @db.Timestamptz(3)
  courtId    Int
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  gameSource GameSource

  // One-to-many relation between Court and Game
  court   Court       @relation(fields: [courtId], references: [id])

  players GameUser[]
  rounds  GameRound[]
  equipment GameEquipment[]

  // Set for TOURNAMENT games only
  tournamentMatch TournamentMatch?

  @@index([courtId])
  @@map("games")
}

// Same shape for singles (1 per team) and doubles (2 per team).
model GameUser {
  gameId     String    @db.Uuid
  userId     String    @db.Uuid
  team       Int
  acceptedAt DateTime? @db.Timestamptz(3) // MATCHED games only; null until the player accepts

  // Match summary, set by Ranking when the final score is reported; null until the game is completed
  ratingBefore Float?
  ratingAfter  Float?

  // One-to-many relation between Game and GameUser
  game Game @relation(fields: [gameId], references: [id])

  // One-to-many relation between User and GameUser
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@id([gameId, userId])
  @@map("game_users")
}

// A set in tennis
model GameRound {
  gameId     String @db.Uuid
  number     Int
  team1Score Int
  team2Score Int

  // One-to-many relation between Game and GameRound
  game Game @relation(fields: [gameId], references: [id])

  @@id([gameId, number])
  @@map("game_rounds")
}

model Equipment {
  id        Int           @id @default(autoincrement())
  userId    String        @db.Uuid
  type      EquipmentType
  name      String
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  nextMaintenanceAt DateTime? @db.Timestamptz(3)
  retiredAt DateTime?     @db.Timestamptz(3)

  user  User            @relation(fields: [userId], references: [id])
  games GameEquipment[]

  @@index([userId])
  @@map("equipment")
}

model GameEquipment {
  gameId      String @db.Uuid
  equipmentId Int

  game      Game      @relation(fields: [gameId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@id([gameId, equipmentId])
  @@index([equipmentId])
  @@map("game_equipment")
}

// An 8-team single-elimination bracket. Players register one by one; when it is full the teams are
// formed by rating and the bracket is drawn.
model Tournament {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  format      Format
  status      TournamentStatus @default(REGISTRATION)
  startsAt    DateTime         @db.Timestamptz(3) // quarterfinals start; later rounds follow an hour apart
  courtId     Int
  creatorId   String           @db.Uuid
  winningTeam Int? // seed of the champion team, set when the final is reported
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  court   Court              @relation(fields: [courtId], references: [id])
  creator User               @relation("TournamentsCreated", fields: [creatorId], references: [id])
  players TournamentPlayer[]
  matches TournamentMatch[]

  @@index([status, startsAt]) // feed order
  @@index([courtId])
  @@index([creatorId])
  @@map("tournaments")
}

// A registered player
model TournamentPlayer {
  tournamentId String   @db.Uuid
  userId       String   @db.Uuid
  team         Int? // the team's seed (1 = top seed), null until the bracket is drawn
  joinedAt     DateTime @default(now()) @db.Timestamptz(3)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@id([tournamentId, userId])
  @@index([userId])
  @@map("tournament_players")
}

// One slot of the bracket. Round 1 is the quarterfinals (positions 0-3), 2 the semifinals (0-1), 3 the final (0).
// The winner of (round, position) plays in (round + 1, position / 2).
model TournamentMatch {
  tournamentId String  @db.Uuid
  round        Int
  position     Int
  team1        Int? // seed playing as team 1 of the game; null until its feeder match is decided
  team2        Int?
  winner       Int? // seed of the team that won, set when the game's score is reported
  gameId       String? @unique @db.Uuid // created once both teams are known

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  game       Game?      @relation(fields: [gameId], references: [id])

  @@id([tournamentId, round, position])
  @@map("tournament_matches")
}
